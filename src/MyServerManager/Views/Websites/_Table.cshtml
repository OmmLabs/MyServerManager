@model WebsiteRow[]
@if (Model.Length == 0)
{
    <div class="empty-state">Add a website URL to an enabled application to start checking its availability.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle data-table mb-0">
            <thead><tr><th scope="col">Website</th><th scope="col">Availability</th><th scope="col">HTTP</th><th scope="col">Response time</th><th scope="col">Last checked (UTC)</th><th scope="col">Details</th><th scope="col">Action</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var health = row.Health;
                var (label, tone) = health?.Available switch { true => ("Healthy", "positive"), false => ("Unavailable", "negative"), _ => ("Pending", "neutral") };
                <tr>
                    <th scope="row"><div>@row.Application.DisplayName</div><a class="fw-normal text-break" href="@row.Application.WebsiteUrl" target="_blank" rel="noopener noreferrer">@row.Application.WebsiteUrl</a></th>
                    <td><span class="status-pill @tone"><span class="status-dot" aria-hidden="true"></span>@label</span></td>
                    <td>@ViewFormat.Number(health?.StatusCode)</td>
                    <td class="text-nowrap">@(health is null ? ViewFormat.Unavailable : $"{health.Milliseconds} ms")</td>
                    <td class="text-nowrap">@ViewFormat.Timestamp(health?.CheckedAt)</td>
                    <td>@(health?.Error ?? "—")</td>
                    <td>
                        <form method="post" asp-action="Check" data-operation>
                            <input type="hidden" name="service" value="@row.Application.ServiceName">
                            <button class="btn btn-outline-primary btn-sm text-nowrap" type="submit">Check now</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
