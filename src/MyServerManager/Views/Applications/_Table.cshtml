@model ApplicationStatus[]
@if (Model.Length == 0)
{
    <div class="empty-state">No registered applications.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0 data-table">
            <thead><tr><th scope="col">Application</th><th scope="col">Service Name</th><th scope="col">Status</th>
                <th scope="col">PID</th><th scope="col">Memory</th><th scope="col">Peak Memory</th>
                <th scope="col">CPU Time</th><th scope="col">Port</th><th scope="col">Website</th><th scope="col">Actions</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <th scope="row">@row.Definition.DisplayName</th>
                    <td><code>@row.Definition.ServiceName</code></td>
                    <td><partial name="_StatusPill" model="row.Status" /></td>
                    <td>@ViewFormat.Number(row.Status.MainPid)</td>
                    <td class="text-nowrap">@ViewFormat.Bytes(row.Status.MemoryBytes)</td>
                    <td class="text-nowrap">@ViewFormat.Bytes(row.Status.PeakBytes)</td>
                    <td class="text-nowrap">@ViewFormat.CpuTime(row.Status.CpuNanoseconds)</td>
                    <td>@ViewFormat.Number(row.Definition.Port)</td>
                    <td>
                        @if (row.Definition.WebsiteUrl is { } url)
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer">@(new Uri(url).Authority)</a>
                        }
                        else { @ViewFormat.Unavailable }
                    </td>
                    <td><partial name="_ApplicationActions" model="row" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
